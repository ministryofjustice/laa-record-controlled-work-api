# Entra-specific overrides for validating real Entra ID tokens instead of the default
# mock-oauth2-server, and (optionally) for the OBO exchange to the datastore.
#
# Not needed for the default `make docker-up` stack - defaults in docker-compose.yml /
# include.api.yml apply if unset. Only loaded for `make docker-up-entra`.
#
# This is the single source of truth for rcw-api's own Entra config, whether rcw-api is run
# standalone or as part of the full stack via ../laa-record-controlled-work/dev:docker:entra.
#
# https://developer.1password.com/docs/cli/secret-reference-syntax

# Resource-server validation of the incoming token (RCW API's own audience).
ISSUER="op://LAA Record Controlled Work/RCW-API/ENTRA_ISSUER"
AUDIENCE="op://LAA Record Controlled Work/RCW-API/ENTRA_CLIENT_ID"

# RCW API -> datastore jwt-bearer (OBO) exchange.
RCW_API_CLIENT_ID="op://LAA Record Controlled Work/RCW-API/ENTRA_CLIENT_ID"
RCW_API_CLIENT_SECRET="op://LAA Record Controlled Work/RCW-API/ENTRA_CLIENT_SECRET"
DATASTORE_TOKEN_URI="op://LAA Record Controlled Work/RCW-API/DS_API_ENTRA_TOKEN_URI"
# Must be the datastore API's Application ID URI + scope name (e.g. api://<ds-client-id>/DataStore.Access)
# - an unqualified scope name resolves to Microsoft Graph instead (AADSTS65001).
DATASTORE_OAUTH_SCOPES="op://LAA Record Controlled Work/RCW-API/DS_API_ENTRA_OAUTH_SCOPES"
