# Copy to .env (git-ignored) and fill in with values from the UI app registration
# in the dev Entra tenant. Bruno loads this file automatically and exposes the 
# values via {{process.env.<NAME>}}.
UAT_ENTRA_TENANT_ID=# RCW UI issuer for UAT
UAT_ENTRA_CLIENT_ID=# RCW UI client ID for UAT
UAT_ENTRA_CLIENT_SECRET=# RCW UI client secret for UAT
STAGING_ENTRA_TENANT_ID=# RCW UI issuer for staging
STAGING_ENTRA_CLIENT_ID=# RCW UI client ID for staging
STAGING_ENTRA_CLIENT_SECRET=# RCW UI client secret for staging
