# Copy to .env (git-ignored) and fill in with values from the UI app registration
# in the dev Entra tenant. Bruno loads this file automatically and exposes the 
# values via {{process.env.<NAME>}}.
ENTRA_TENANT_ID=# RCW API issuer
ENTRA_CLIENT_ID=# RCW API client ID
ENTRA_CLIENT_SECRET=# RCW API client secret
