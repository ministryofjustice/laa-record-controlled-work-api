{
  "extends": ["github>ministryofjustice/devsecops-actions"],
  "ignorePaths": ["record-controlled-work-service/dependency-overrides.gradle"],
  "schedule": [
    "after 10pm every weekday",
    "every weekend",
    "before 5am every weekday"
  ],
  "timezone": "Europe/London",
  "packageRules": [
    {
      "description": "Rebase PRs only when conflicted",
      "matchDatasources": ["maven", "gradle", "gradle-version"],
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "7 days",
      "rebaseWhen": "conflicted"
    }
  ]
}