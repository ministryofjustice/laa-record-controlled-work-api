{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "aud": "default",
            "roles": [
              "Applications.Read"
            ]
          }
        },
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "aud": "default",
            "roles": [
              "Applications.Read",
              "Applications.Write"
            ]
          }
        }
      ]
    }
  ]
}